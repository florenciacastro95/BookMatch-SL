
@model Bookmatch_SL.Models.Libro

@{
    ViewData["Title"] = "Publicar libro";
}

<div class="container mt-4" style="max-width: 650px;">
    <h2>Publicar un libro</h2>

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Autor" class="form-label"></label>
            <input asp-for="Autor" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Editorial" class="form-label"></label>
            <input asp-for="Editorial" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Idioma" class="form-label"></label>
            <input asp-for="Idioma" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="CategoriaId" class="form-label">
                Categoría
            </label>

            <select asp-for="CategoriaId"
                    class="form-select"
                    asp-items="@(new SelectList(ViewBag.Categorias, "Id", "Nombre"))">
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Formato" class="form-label"></label>

            <select asp-for="Formato"
                    class="form-select"
                    asp-items="Html.GetEnumSelectList<Bookmatch_SL.Models.Enums.Formato>()">
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="EstadoConservacion" class="form-label">
                Estado de conservación
            </label>

            <select asp-for="EstadoConservacion"
                    class="form-select"
                    asp-items="Html.GetEnumSelectList<Bookmatch_SL.Models.Enums.EstadoConservacion>()">
            </select>
        </div>

        <div class="mb-3">
            <label for="portadaArchivo" class="form-label">
                Imagen de portada
            </label>

            <input type="file"
                   id="portadaArchivo"
                   name="portadaArchivo"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp"
                   required />

            <small class="text-muted">
                JPG, PNG o WEBP. Máximo 5 MB.
            </small>
        </div>

        <div class="mb-3">
            <label asp-for="Aclaracion" class="form-label"></label>
            <textarea asp-for="Aclaracion" class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Guardar libro
        </button>

        <a asp-action="MiBiblioteca"
           class="btn btn-outline-secondary">
            Cancelar
        </a>
    </form>
</div>
