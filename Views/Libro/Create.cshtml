@model Bookmatch_SL.Models.Libro

@{
    ViewData["Title"] = "Publicar libro";
}

<div class="container mt-4">
    <h2>Publicar un Libro</h2>
    <form asp-action="Create">
        <div class="mb-3">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Autor" class="form-label"></label>
            <input asp-for="Autor" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Editorial" class="form-label"></label>
            <input asp-for="Editorial" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Idioma" class="form-label"></label>
            <input asp-for="Idioma" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="CategoriaId" class="form-label">Categoría</label>
            <select asp-for="CategoriaId" class="form-control" asp-items="@(new SelectList(ViewBag.Categorias, "Id", "Nombre"))"></select>
        </div>
        <div class="mb-3">
            <label asp-for="Formato" class="form-label"></label>
            <select asp-for="Formato" class="form-control" asp-items="Html.GetEnumSelectList<Bookmatch_SL.Models.Enums.Formato>()"></select>
        </div>
        <div class="mb-3">
            <label asp-for="EstadoConservacion" class="form-label"></label>
            <select asp-for="EstadoConservacion" class="form-control" asp-items="Html.GetEnumSelectList<Bookmatch_SL.Models.Enums.EstadoConservacion>()"></select>
        </div>
        <div class="mb-3">
            <label asp-for="PortadaUrl" class="form-label">URL de la portada</label>
            <input asp-for="PortadaUrl" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Aclaracion" class="form-label"></label>
            <textarea asp-for="Aclaracion" class="form-control"></textarea>
        </div>
        <button type="submit" class="btn">Guardar</button>
        <a asp-action="Index" class="btn">Cancelar</a>
    </form>
</div>