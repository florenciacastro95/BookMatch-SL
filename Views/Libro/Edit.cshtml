
@model Bookmatch_SL.Models.Libro

@{
    ViewData["Title"] = "Editar libro";

    bool disponibilidadBloqueada =
        ViewBag.DisponibilidadBloqueada is bool bloqueada && bloqueada;
}

<div class="container mt-4" style="max-width: 650px;">
    <h2>Editar libro</h2>

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Autor" class="form-label"></label>
            <input asp-for="Autor" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Editorial" class="form-label"></label>
            <input asp-for="Editorial" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Idioma" class="form-label"></label>
            <input asp-for="Idioma" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="CategoriaId" class="form-label">
                Categoría
            </label>

            <select asp-for="CategoriaId"
                    class="form-select"
                    asp-items="@(new SelectList(ViewBag.Categorias, "Id", "Nombre"))">
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Formato" class="form-label"></label>

            <select asp-for="Formato"
                    class="form-select"
                    asp-items="Html.GetEnumSelectList<Bookmatch_SL.Models.Enums.Formato>()">
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="EstadoConservacion" class="form-label">
                Estado de conservación
            </label>

            <select asp-for="EstadoConservacion"
                    class="form-select"
                    asp-items="Html.GetEnumSelectList<Bookmatch_SL.Models.Enums.EstadoConservacion>()">
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Portada actual</label>

            <div>
                <img src="@Model.PortadaUrl"
                     alt="Portada actual de @Model.Titulo"
                     style="width: 120px; height: 160px; object-fit: cover;" />
            </div>
        </div>

        <div class="mb-3">
            <label for="portadaArchivo" class="form-label">
                Cambiar portada (opcional)
            </label>

            <input type="file"
                   id="portadaArchivo"
                   name="portadaArchivo"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp" />
        </div>

        <div class="mb-3">
            <label asp-for="Aclaracion" class="form-label"></label>
            <textarea asp-for="Aclaracion" class="form-control"></textarea>
        </div>

        <div class="mb-3 form-check">
            @if (disponibilidadBloqueada)
            {
                @if (Model.Disponible)
                {
                    <input type="checkbox"
                           class="form-check-input"
                           checked
                           disabled />
                }
                else
                {
                    <input type="checkbox"
                           class="form-check-input"
                           disabled />
                }

                <input type="hidden"
                       name="Disponible"
                       value="@Model.Disponible.ToString().ToLowerInvariant()" />

                <label class="form-check-label">
                    Disponible para trueque (bloqueado)
                </label>

                <div class="form-text">
                    No podés cambiar la disponibilidad mientras este
                    libro tenga una solicitud pendiente o un intercambio
                    aceptado o exitoso. El módulo de intercambios controla
                    cuándo se libera.
                </div>
            }
            else
            {
                <input asp-for="Disponible"
                       class="form-check-input" />

                <label asp-for="Disponible"
                       class="form-check-label">
                    Disponible para trueque
                </label>
            }
        </div>

        <button type="submit" class="btn btn-primary">
            Guardar cambios
        </button>

        <a asp-action="MiBiblioteca"
           class="btn btn-outline-secondary">
            Volver a mi biblioteca
        </a>
    </form>
</div>
