@model Bookmatch_SL.Models.Libro
@using System.Security.Claims

@{
    ViewData["Title"] = "Detalle del libro";

    string? idUsuarioActual = User.FindFirstValue(ClaimTypes.NameIdentifier);

    bool esPropietario = Model.UsuarioId.ToString() == idUsuarioActual;
    bool esAdministrador = User.IsInRole("Administrador");
    bool estaAutenticado = User.Identity?.IsAuthenticated == true;
}

<div class="container mt-4">
    <div class="row g-4">
        <div class="col-md-4">
            @if (!string.IsNullOrWhiteSpace(Model.PortadaUrl))
            {
                <img src="@Model.PortadaUrl" class="img-fluid rounded" alt="Portada de @Model.Titulo" />
            }
        </div>

        <div class="col-md-8">
            <h1>@Model.Titulo</h1>

            <p>
                <strong>Autor:</strong> @Model.Autor
            </p>

            <p>
                <strong>Editorial:</strong> @Model.Editorial
            </p>

            <p>
                <strong>Idioma:</strong> @Model.Idioma
            </p>

            <p>
                <strong>Formato:</strong> @Model.Formato
            </p>

            <p>
                <strong>Estado de conservación:</strong>
                @Model.EstadoConservacion
            </p>

            <p>
                <strong>Categoría:</strong> @Model.Categoria?.Nombre
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.Aclaracion))
            {
                <p>
                    <strong>Aclaración:</strong> @Model.Aclaracion
                </p>
            }
        </div>
    </div>

    <div class="mt-4 d-flex flex-wrap gap-3">
        @if (estaAutenticado && (esPropietario || esAdministrador))
        {
            <a asp-controller="Libro" asp-action="Edit" asp-route-id="@Model.Id" class="boton boton-secundario">
                Editar libro
            </a>
        }

        @if (Model.Activo && Model.Disponible && !esPropietario && estaAutenticado)
        {
            <a asp-controller="Intercambio" asp-action="Solicitar" asp-route-id="@Model.Id" class="boton boton-principal">
                Solicitar BookMatch
            </a>
        }
        else if (Model.Activo && Model.Disponible && !estaAutenticado)
        {
            <a asp-controller="Auth" asp-action="Login" class="boton boton-principal">
                Ingresá para solicitar un intercambio
            </a>
        }

        <a asp-action="Index" class="boton boton-secundario">
            Volver al catálogo
        </a>
    </div>
</div>