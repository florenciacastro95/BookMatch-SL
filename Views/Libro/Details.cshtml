@model Bookmatch_SL.Models.Libro

@{
    ViewData["Title"] = "Detalle del Libro";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <img src="@Model.PortadaUrl" class="img-fluid rounded" alt="Portada del libro">
        </div>
        <div class="col-md-8">
            <h2>@Model.Titulo</h2>
            <hr />
            <p><strong>Autor:</strong> @Model.Autor</p>
            <p><strong>Editorial:</strong> @Model.Editorial</p>
            <p><strong>Idioma:</strong> @Model.Idioma</p>
            <p><strong>Formato:</strong> @Model.Formato</p>
            <p><strong>Categoría:</strong> @Model.Categoria?.Nombre</p>
            <p><strong>Estado de Conservación:</strong> @Model.EstadoConservacion</p>
            <p><strong>Propietario:</strong> @Model.Usuario?.Nombre</p>
            @if (!string.IsNullOrEmpty(Model.Aclaracion))
            {
                <p><strong>Aclaración:</strong> @Model.Aclaracion</p>
            }

            <div class="mt-4">
                <!-- Botón que conecta con la vista interc-->
                <a asp-controller="Intercambio" asp-action="Solicitar" asp-route-id="@Model.Id" class="btn btn-success">
                    Solicitar bookmatch
                </a>
                <a asp-action="Index" class="btn btn-secondary">Volver al catálogo</a>
            </div>
        </div>
    </div>
</div>