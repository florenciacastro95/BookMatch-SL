@model CambiarPasswordViewModel

@{
    ViewData["Title"] = "Cambiar contraseña";
}

<h1>Cambiar contraseña</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="CambiarPassword" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="PasswordActual" class="form-label">
                    Contraseña actual
                </label>

                <input asp-for="PasswordActual" class="form-control" />
                <span asp-validation-for="PasswordActual"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PasswordNueva" class="form-label">
                    Nueva contraseña
                </label>

                <input asp-for="PasswordNueva" class="form-control" />
                <span asp-validation-for="PasswordNueva"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmarPassword" class="form-label">
                    Confirmar nueva contraseña
                </label>

                <input asp-for="ConfirmarPassword" class="form-control" />
                <span asp-validation-for="ConfirmarPassword"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Cambiar contraseña
            </button>

            <a asp-action="Perfil"
               class="btn btn-outline-secondary">
                Volver
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}