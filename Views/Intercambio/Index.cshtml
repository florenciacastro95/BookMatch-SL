@{
    ViewData["Title"] = "Intercambios";
}

<h1>Intercambios</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-secundary text-center p-4">
        <p class="h5 mb-2">No hay intercambios registrados.</p>
        <p class="mb-3">
            Publicá un libro o buscá uno que te interese para comenzar.
        </p>
    </div>


}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Número</th>
                <th>Usuario origen (ID)</th>
                <th>Usuario destino (ID)</th>
                <th>Libro ofrecido </th>
                <th>Libro solicitado </th>
                <th>Estado</th>
                <th>Fecha</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Bookmatch_SL.Models.Intercambio solicitudIntercambio in Model)
            {
                <tr>
                    <td>@solicitudIntercambio.Id</td>
                    <td>@solicitudIntercambio.UsuarioOrigenId</td>
                    <td>@solicitudIntercambio.UsuarioDestinoId</td>
                    <td>@solicitudIntercambio.LibroOfrecido.Titulo</td>
                    <td>@solicitudIntercambio.LibroSolicitado.Titulo</td>
                    <td>@solicitudIntercambio.Estado</td>
                    <td>@solicitudIntercambio.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}