@{
    ViewData["Title"] = "Intercambios";
}

<h1>Intercambios</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-secundary text-center p-4">
        <p class="h5 mb-3">No hay intercambios registrados</p>
        <p class="mb-5">
            Para poder hacer Bookmatch con otros libros, necesitás tener cargado al menos un libro para ofrecer el
            intercambio
        </p>
        <a asp-controller="Libro" asp-action="Create" class="boton boton-principal">
            Publicar un libro
        </a>
    </div>


}
else
{
    <div class="table-responsive">
        <table class="table listado-intercambios">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Usuario origen (id)</th>
                    <th>Usuario destino (id)</th>
                    <th>Libro ofrecido </th>
                    <th>Libro solicitado </th>
                    <th>Estado</th>
                    <th>Fecha</th>

                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Bookmatch_SL.Models.Intercambio solicitudIntercambio in Model)
                {
                    <tr>
                        <td>@solicitudIntercambio.Id</td>
                        <td>@solicitudIntercambio.UsuarioOrigenId</td>
                        <td>@solicitudIntercambio.UsuarioDestinoId</td>
                        <td>@solicitudIntercambio.LibroOfrecido.Titulo</td>
                        <td>@solicitudIntercambio.LibroSolicitado.Titulo</td>
                        <td>@solicitudIntercambio.Estado</td>
                        <td>@solicitudIntercambio.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    
                    
                    
                        <td>
                            <a asp-action="Detalle" asp-route-id="@solicitudIntercambio.Id"
                               asp-route-pagina="@ViewBag.PaginaActual">
                                Ver detalle
                            </a>
                        </td>
               
               
                    </tr>
                }
            </tbody>
        </table>
    </div>




    <div class="d-flex justify-content-between align-items-center">
        @if (ViewBag.PaginaActual > 1)
        {
            <a asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual - 1)" class="btn btn-secondary">
                Anterior
            </a>
        }

        <span>
            Página @ViewBag.PaginaActual de @ViewBag.TotalPaginas
        </span>

        @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
        {
            <a asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual + 1)" class="btn btn-secondary">
                Siguiente
            </a>
        }
    </div>


}