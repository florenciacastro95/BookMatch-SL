@{
    ViewData["Title"] = "Solicitar intercambio";
}

<div class="solicitar-intercambio mt-4">
    <h1 class="mb-3">Solicitar intercambio</h1>
    <p class="mb-4">
        Elegí uno de tus libros para ofrecer a cambio del libro que te interesa.
    </p>

    <form asp-controller="Intercambio" asp-action="Solicitar" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"> </div>
        <input type="hidden" name="LibroSolicitadoId" value="@ViewBag.LibroSolicitadoId" />
            
        <div class="mb-4">
         
            <p class="mb-1">Libro que querés recibir</p>
            <p>@ViewBag.LibroSolicitadoTitulo</p>
        </div>

        <div class="mb-3">
            <label for="libroOfrecido" class="form-label">
                Libro para intercambiar
            </label>
            <select id="libroOfrecido" name="LibroOfrecidoId" class="form-select" aria-describedby="ayudaLibroOfrecido"
                    required>
                <option value="">Seleccioná uno de tus libros</option>

                @foreach (Bookmatch_SL.Models.Libro libro in ViewBag.LibrosParaOfrecer)
                {
                    <option value="@libro.Id">@libro.Titulo</option>
                }
            </select>
            @if (ViewBag.LibrosParaOfrecer.Count == 0)
            {
                <p id="ayudaLibroOfrecido" class="mt-2">
                    No tenés libros disponibles para ofrecer.
                    <a asp-controller="Libro" asp-action="Create">
                        Publicá un libro
                    </a>
                    para comenzar.
                </p>
            }
        </div>



        <div class="d-flex flex-wrap align-items-center gap-3">
            <button type="submit" class="boton boton-principal">
                Enviar propuesta
            </button>
 
            <a asp-action="Index" class="enlace-volver">
                Cancelar
            </a>
        </div>
    </form>
</div>