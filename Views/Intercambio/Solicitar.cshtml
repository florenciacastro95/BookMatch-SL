@{
    ViewData["Title"] = "Solicitar intercambio";
}

<h1>Solicitar intercambio</h1>

<p>Elegí un libro propio, para ofrecer a cambio del libro que te interesa</p>

<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2 class="card-title h4 mb-3">Solicitar intercambio</h2>
            <p class="text-secondary mb-4">
                Seleccioná uno de tus libros, para proponer el trueque por el libro que te interesa
            </p>

            <form asp-controller="Intercambio" asp-action="Solicitar" method="post">
                
                
                <div class="mb-3">
                    <label for="libroSolicitado" class="form-label fw-bold">Libro que queres recibir</label>
                    <input id="libroSolicitado" type="text" class="form-control"
                           placeholder="Elegí un libro del catálogo" disabled />
               
                </div>

                


                
                <div class="mb-4">
                    <label for="libroOfrecido" class="form-label fw-bold">Libro que entregás a cambio</label>
                    
 
                    <select id="libroOfrecido" cla ss="form-select" disabled>
                        <option selected disabled> Seleccioná uno de tus libros </option>
                    </select>

                    <div class="form-text text-secondary mt-1">
                        No ves tus libros? Asegurate de haber publicado previamente, al menos un libro en tu
                        biblioteca.
                    </div>
                </div>

                
                <div class="d-flex gap-2 pt-2">
                    <button type="submit" class="btn btn-primary" disabled>
                        Enviar propuesta
                    </button>

                    <a asp-controller="Intercambio" asp-action="Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>