@{
    ViewData["Title"] = "Solicitar intercambio";
}

<div class="solicitar-intercambio mt-4">
    <h1 class="mb-3">Solicitar intercambio</h1>
    <p class="mb-4">
        Elegí uno de tus libros para ofrecer a cambio del libro que te interesa.
    </p>

    <form asp-controller="Intercambio" asp-action="Solicitar" method="post">
        <input type="hidden" name="LibroSolicitadoId" value="@ViewBag.LibroSolicitadoId" />
        <div class="mb-4">
            <label for="libroSolicitado" class="form-label">
                Libro que querés recibir
            </label>

            <input id="libroSolicitado" type="text" class="form-control" value="@ViewBag.LibroSolicitadoTitulo"
                   placeholder="Elegí un libro del catálogo" readonly />
        </div>

        <div class="mb-4">
            <label for="libroOfrecido" class="form-label">
                Libro que ofrecés
            </label>

            <select id="libroOfrecido" class="form-select" aria-describedby="ayudaLibroOfrecido" disabled>
                <option>Seleccioná uno de tus libros</option>
            </select>

            <p id="ayudaLibroOfrecido" class="mt-2">
                Para ofrecer un libro, primero debe estar publicado
                y disponible en tu biblioteca.
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3">



            <button type="submit" class="boton boton-principal" disabled>
                Enviar propuesta
            </button>
 
            <a asp-action="Index" class="enlace-volver">
                Cancelar
            </a>
        </div>
    </form>
</div>