@model Bookmatch_SL.Models.Intercambio
@using System.Security.Claims
@using Bookmatch_SL.Models.Enums

@{
    ViewData["Title"] = "Detalle del intercambio";
    string? identificadorUsuario = User.FindFirstValue(ClaimTypes.NameIdentifier);

    bool esUsuarioOrigen = identificadorUsuario == Model.UsuarioOrigenId.ToString();
    bool esUsuarioDestino = identificadorUsuario == Model.UsuarioDestinoId.ToString();
    bool esParticipante = esUsuarioOrigen || esUsuarioDestino;
}

<div class="detalle-intercambio mt-4">
    <h1 class="mb-4">Intercambio número @Model.Id</h1>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <dl class="mb-0">
                <dt>Libro ofrecido</dt>
                <dd>@Model.LibroOfrecido.Titulo</dd>
            </dl>
        </div>

        <div class="col-md-6">
            <dl class="mb-0">
                <dt>Libro solicitado</dt>
                <dd>@Model.LibroSolicitado.Titulo</dd>
            </dl>
        </div>
    </div>

    <dl class="mb-4">
        <dt>Estado</dt>
        <dd>
            <span class="estado-intercambio estado-@Model.Estado.ToString().ToLowerInvariant()">
                @Model.Estado
            </span>
        </dd>

        <dt>Fecha de solicitud de intercambio</dt>
        <dd>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>

    @if (TempData["Exito"] != null)
    {
        <p role="status">@TempData["Exito"]</p>
    }

    @if (TempData["Error"] != null)
    {
        <p class="text-danger" role="alert">@TempData["Error"]</p>
    }

    <div class="d-flex flex-wrap gap-3 mb-4">
        @if (Model.PuedeCambiarA(EstadoIntercambio.Aceptado) && esUsuarioDestino)
        {
            <button type="button" class="boton boton-intercambio" data-bs-toggle="modal"
                    data-bs-target="#confirmarAceptacion">
                <svg class="icono-intercambio" aria-hidden="true"><use href="#icono-intercambio" /></svg>
                Aceptar intercambio
            </button>
        }

        @if (Model.PuedeCambiarA(EstadoIntercambio.Rechazado) && esUsuarioDestino)
        {
            <button type="button" class="boton boton-rechazo" data-bs-toggle="modal" data-bs-target="#confirmarRechazo">
                Rechazar propuesta
            </button>
        }

        @if (Model.PuedeCambiarA(EstadoIntercambio.Exitoso) && esParticipante)
        {
            <button type="button" class="boton boton-principal" data-bs-toggle="modal"
                    data-bs-target="#confirmarFinalizacion">
                Finalizar intercambio
            </button>
        }

        @if (Model.PuedeCambiarA(EstadoIntercambio.Cancelado) && esParticipante)
        {
            <button type="button" class="boton boton-secundario" data-bs-toggle="modal"
                    data-bs-target="#confirmarCancelacion">
                Cancelar intercambio
            </button>
        }
    </div>

    @if (Model.PuedeCambiarA(EstadoIntercambio.Aceptado) && esUsuarioDestino)
    {
        <div class="modal fade" id="confirmarAceptacion" tabindex="-1" aria-labelledby="tituloAceptacion"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content modal-confirmacion">
                    <h2 id="tituloAceptacion" class="h5 mb-4">
                        ¿Desea aceptar este intercambio?
                    </h2>

                    <form asp-action="Aceptar" method="post" class="d-flex gap-3">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="boton boton-principal">
                            Sí
                        </button>
                        <button type="button" class="boton boton-secundario" data-bs-dismiss="modal">
                            No
                        </button>
 
                    </form>
                </div>
            </div>
        </div>
    }

    @if (Model.PuedeCambiarA(EstadoIntercambio.Rechazado) && esUsuarioDestino)
    {
        <div class="modal fade" id="confirmarRechazo" tabindex="-1" aria-labelledby="tituloRechazo" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content modal-confirmacion">
                    <h2 id="tituloRechazo" class="h5 mb-4">
                        ¿Desea rechazar esta propuesta?
                    </h2>

                    <form asp-action="Rechazar" method="post" class="d-flex gap-3">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="boton boton-principal">
                            Sí
                        </button>
                        <button type="button" class="boton boton-secundario" data-bs-dismiss="modal">
                            No
                        </button>
 
                    </form>
                </div>
            </div>
        </div>
    }

    @if (Model.PuedeCambiarA(EstadoIntercambio.Exitoso) && esParticipante)
    {
        <div class="modal fade" id="confirmarFinalizacion" tabindex="-1" aria-labelledby="tituloFinalizacion"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content modal-confirmacion">
                    <h2 id="tituloFinalizacion" class="h5 mb-4">
                        ¿Se concretó el intercambio de libros?
                    </h2>

                    <form asp-action="MarcarExitoso" method="post" class="d-flex gap-3">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="boton boton-principal">
                            Sí
                        </button>
                        <button type="button" class="boton boton-secundario" data-bs-dismiss="modal">
                            No
                        </button>
 
                    </form>
                </div>
            </div>
        </div>
    }

    @if (Model.PuedeCambiarA(EstadoIntercambio.Cancelado) && esParticipante)
    {
        <div class="modal fade" id="confirmarCancelacion" tabindex="-1" aria-labelledby="tituloCancelacion"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content modal-confirmacion">
                    <h2 id="tituloCancelacion" class="h5 mb-4">
                        ¿Desea cancelar este intercambio?
                    </h2>

                    <form asp-action="Cancelar" method="post" class="d-flex gap-3">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="boton boton-principal">
                            Sí
                        </button>
                        <button type="button" class="boton boton-secundario" data-bs-dismiss="modal">
                            No
                        </button>

                        
                    </form>
                </div>
            </div>
        </div>
    }

    <partial name="_Mensajes" model="Model" />

    <a asp-action="Index" asp-route-pagina="@ViewBag.PaginaActual" class="boton boton-secundario">
        Regresar al listado
    </a>
</div>

@* los scripts van en la sección Scripts del layout porque una vista parcial no puede tener secciones *@
@section Scripts {
    @* la librería de SignalR se carga igual que en el ejemplo de clase *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/3.1.10/signalr.min.js"></script>
    <script type="text/javascript">
        // datos que necesita chatIntercambio.js para saber qué intercambio es y quién soy
        const intercambioId = @Model.Id;
        const idUsuarioAutenticado = @(identificadorUsuario ?? "0");
    </script>
    <script src="~/js/chatIntercambio.js" asp-append-version="true"></script>
}