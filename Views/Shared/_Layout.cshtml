<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Bookmatch-SL</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bookmatch_SL.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/bookmatch.ico" />

    <link
    href="https://fonts.googleapis.com/css2?family=Andika:wght@400;700&family=Josefin+Sans:wght@500;600;700&display=swap"
    rel="stylesheet" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg encabezado-bookmatch mb-3" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/bookmatch.ico" alt="" width="40" height="40" />
                    <span>BookMatch-SL</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarBookmatch"
                        aria-controls="navbarBookmatch" aria-expanded="false" aria-label="Abrir navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarBookmatch">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Libro" asp-action="Index">
                                Catálogo
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Libro" asp-action="MiBiblioteca">
                                    Mi biblioteca
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Intercambio" asp-action="Index">
                                    Intercambio
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Perfil">
                                    Mi perfil
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="CambiarPassword">
                                    Cambiar contraseña
                                </a>
                            </li>

                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Usuarios" asp-action="Index">
                                        Usuarios
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Auditoria" asp-action="Index">
                                        Auditoría
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="navbar-text">
                                Hola, @User.Identity.Name
                            </span>

                            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-outline-secondary">
                                    Cerrar sesión
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary">
                                Ingresar
                            </a>

                            <a asp-controller="Auth" asp-action="Registro" class="btn btn-primary">
                                Registrarme
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container py-3">
            &copy; 2026 - Bookmatch-SL
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>